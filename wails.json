{
  "$schema": "https://wails.io/schemas/config.v2.json",
  "name": "KOVA Voice Studio",
  "outputfilename": "KOVA-Voice-Studio",
  "frontend:dir": "frontend",
  "frontend:install": "npm install",
  "frontend:build": "npm run build",
  "frontend:dev:watcher": "npm run dev",
  "frontend:dev:serverUrl": "auto",
  "author": { "name": "KOVA", "email": "" },
  "postBuildHooks": {
    "windows/amd64": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../../scripts/package-windows.ps1 ${bin}"
  },
  "info": {
    "companyName": "KOVA",
    "productName": "KOVA Voice Studio",
    "productVersion": "1.0.2.0",
    "copyright": "Copyright (c) 2026 KOVA",
    "comments": "Private desktop client for a user-controlled KOVA Voice Studio worker."
  }
}
